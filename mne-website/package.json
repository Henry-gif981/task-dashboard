    "morph": "node tools/test-morph.mjs",
    "check": "node tools/check.mjs",
    "screens": "node tools/screens.mjs",
    "slides": "node tools/slides-md.mjs",
    "pdf": "node tools/export-pdf.mjs",
    "standalone": "python3 tools/standalone.py",
    "art": "python3 tools/engrave.py && python3 tools/textures.py"
  },
  "engines": {
    "node": ">=20.11"
  }
